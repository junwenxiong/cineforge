# CineForge local settings: a template for your private .env file.
#
# `python3 tools/setup.py init` copies this file to .env (gitignored, chmod 600)
# and asks for your Hugging Face token with hidden input. Fill other values by
# editing .env in a text editor. Never commit .env or paste its values into chat,
# issues, notebooks or logs. Variables already set in your shell win over .env.
# Empty or commented-out lines are ignored.

# Required. Hugging Face read token: https://huggingface.co/settings/tokens
# First accept the LTX-2.5 license while logged in: https://huggingface.co/Lightricks/LTX-2.5
# Fine-grained tokens also need "Read access to contents of all public gated
# repos you can access". Replace it later with: python3 tools/setup.py init --reset-hf
HF_TOKEN=

# Optional. Farm password for tools/film/farm_server.py --token-env CINEFORGE_FARM_TOKEN.
# Pick a long random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CINEFORGE_FARM_TOKEN=

# Optional, H3 route only. The VM folder inside your own licensed DramaPie Box install.
# CINEFORGE_BOX_VM_DIR=

# Optional. Reference pictures with tools/film/gpt_images.py.
# OPENAI_API_KEY=
# Compatible server origin without /v1. Default: https://api.openai.com
# CINEFORGE_IMAGE_BASE_URL=

# Optional. tools/h3_queue.py: the canvas link or canvas key from your local Box.
# DRAMAPIE_ENTRY=
# DRAMAPIE_API_KEY=

# Optional. Film used when --film is omitted (default: starcore).
# FILM=starcore
